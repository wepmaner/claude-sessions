<Window x:Class="ClaudeSessions.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Sessions"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Grid Margin="12">
        <Border x:Name="Glow" CornerRadius="16" Background="#F2B03D" Opacity="0" Margin="-3" IsHitTestVisible="False">
            <Border.Effect>
                <BlurEffect Radius="10" />
            </Border.Effect>
        </Border>

        <Border x:Name="Badge" CornerRadius="14" Background="#262932" BorderBrush="#3A3E4A" BorderThickness="1"
                Padding="11,5,13,6" Cursor="SizeAll"
                MouseEnter="Badge_MouseEnter"
                MouseLeftButtonDown="Badge_MouseLeftButtonDown"
                MouseMove="Badge_MouseMove"
                MouseLeftButtonUp="Badge_MouseLeftButtonUp">
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="DecisionPart" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,9,0">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="#EF5B5B" />
                    <TextBlock x:Name="DecisionCount" Margin="6,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="#E6E8EC" VerticalAlignment="Center" />
                </StackPanel>
                <Ellipse x:Name="Dot" Width="9" Height="9" VerticalAlignment="Center" Fill="#5A5E69" />
                <TextBlock x:Name="Label" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="#E6E8EC" VerticalAlignment="Center" Text="…" />
            </StackPanel>
        </Border>

        <Popup x:Name="ListPopup" PlacementTarget="{Binding ElementName=Badge}" Placement="Custom"
               AllowsTransparency="True" StaysOpen="True">
            <Border x:Name="ListBorder" Margin="0,0,10,10" CornerRadius="8" Background="#262932"
                    BorderBrush="#3A3E4A" BorderThickness="1" Padding="0,4" MinWidth="230">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel x:Name="Rows" />
                    <Border x:Name="FooterLine" Height="1" Background="#3A3E4A" Margin="0,4" />
                    <StackPanel x:Name="Footer" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
